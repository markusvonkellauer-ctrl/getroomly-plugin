# ==============================================
# GetRoomly Plugin — local development env
# ==============================================
#
# This file is for `npm run dev` only. Production builds inline none of
# these values; the published plugin bundle reads everything from
# `window.GetRoomlyEmbedConfig` at runtime.

# Environment label — affects dev-only console logging
VITE_APP_ENV=development

# Backend URL the plugin POSTs /v1/generate to. Required for local dev.
# The in-code default is the literal placeholder `__API_BASE_URL__`, which is
# only substituted inside the Docker image at container start — so if you leave
# this unset, requests go to `__API_BASE_URL__/v1/generate` and fail.
# Production is https://api.getroomly.ai (baked into the deployed image).
VITE_API_BASE_URL=http://localhost:3000

# Partner API key for the dev demo at `npm run dev`. Issue one via the
# backend `CreatePartner` tool. **Never set this in production builds**
# — production host pages provide their own key via
# window.GetRoomlyEmbedConfig.apiKey.
VITE_GETROOMLY_API_KEY=grm_pub_replace_me

# Optional dev toggles
# VITE_DEBUG_COORDINATES=true     # show coordinate overlay on the room photo
# VITE_DEFAULT_LANGUAGE=en        # 'en' or 'sv'