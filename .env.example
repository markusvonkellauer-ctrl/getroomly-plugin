# ==============================================
# GetRoomly Plugin - Environment Configuration
# ==============================================

# AI Service Configuration
# nanoBanana API Key for AI image generation
VITE_NANO_BANANA_API_KEY=your_nanobanana_api_key_here

# API Configuration
# GetRoomly API Base URL (leave empty for relative URLs in dev)
VITE_API_BASE_URL=

# Archive Service Configuration
# External archive service for storing generated images
VITE_ARCHIVE_SERVICE_URL=https://your-archive-service.com/api
VITE_ARCHIVE_API_KEY=your_archive_api_key_here

# Analytics Configuration
# Google Analytics Measurement ID (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Configuration (if using Supabase for data storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Application Configuration
# Environment: development, staging, production
VITE_APP_ENV=development

# Features Configuration
# Enable/disable debug coordinate overlay
VITE_DEBUG_COORDINATES=false

# Enable/disable analytics tracking
VITE_ENABLE_ANALYTICS=true

# API Timeouts (in milliseconds)
VITE_API_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=60000

# Image Processing Configuration
# Maximum image width for compression
VITE_MAX_IMAGE_WIDTH=1600

# Maximum image file size (in bytes)
VITE_MAX_FILE_SIZE=10485760

# Image compression quality (0.1 to 1.0)
VITE_COMPRESSION_QUALITY=0.75

# UI Configuration
# Default language (en, sv)
VITE_DEFAULT_LANGUAGE=en

# Theme configuration
VITE_DEFAULT_THEME=light

# External Services
# Feedback service endpoint
VITE_FEEDBACK_SERVICE_URL=https://your-feedback-service.com/api

# Error Reporting (if using Sentry or similar)
VITE_SENTRY_DSN=your_sentry_dsn_here

# Rate Limiting
# Maximum API requests per minute
VITE_RATE_LIMIT_RPM=30

# Development Configuration
# Hot reload settings
VITE_HMR_PORT=24678

# ==============================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with actual API keys
# 3. Never commit .env file to version control
# =============================================="